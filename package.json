{
  "name": "@spark-ui/monorepo",
  "version": "1.0.0",
  "private": false,
  "description": "Experience The Magic Of Animated Components. Crafted With Vue, TypeScript, TailwindCss And Vueuse Motion",
  "keywords": [
    "animated-ui",
    "nuxt-ui",
    "nuxt-ui-components",
    "ui",
    "ui-components",
    "vue3-ui",
    "vue3-ui-components"
  ],
  "homepage": "https://ui.selemon.dev",
  "bugs": {
    "url": "https://github.com/selemondev/spark-ui/issues"
  },
  "license": "MIT",
  "author": "Selemondev",
  "repository": {
    "type": "git",
    "url": "https://github.com/selemondev/spark-ui.git"
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "build": "bun run --filter @spark-ui/docs build",
    "typecheck": "vue-tsc -b docs/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "sync:magic-ui": "node scripts/clone-magic-ui.ts && node scripts/build-magic-ui-registry.ts && node scripts/build-spark-ui-registry.ts && node scripts/compare-registries.ts && node scripts/update-component-history.ts && node scripts/normalize-repository.ts",
    "sync:magic-ui:issues": "node scripts/create-agent-issues.ts",
    "validate:agent-pr": "node scripts/validate-component.ts",
    "normalize:repository": "node scripts/normalize-repository.ts",
    "normalize:repository:check": "node scripts/normalize-repository.ts --check",
    "clean": "rimraf docs/.vitepress/dist docs/.vitepress/cache",
    "build:docs": "bun run --filter @spark-ui/docs build",
    "test": "vp test run",
    "test:watch": "vp test",
    "coverage": "vp test run --coverage",
    "docs:dev": "bun run --filter @spark-ui/docs dev",
    "generate:release": "bunx changelogen@latest --release",
    "release:major": "node scripts/release.ts --major",
    "postinstall": "simple-git-hooks",
    "package-minor:updates": "bunx taze@latest minor -r",
    "package-major:updates": "bunx taze@latest major -r"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@vue/compiler-core": "^3.5.39",
    "cross-env": "^7.0.3",
    "motion-v": "2.4.2",
    "typescript": "^5.9.3",
    "vite-plugin-posthog": "^2.1.0",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@shikijs/transformers": "^3.23.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^11.3.0",
    "autoprefixer": "^10.5.2",
    "eslint-plugin-format": "^0.1.3",
    "flexsearch": "^0.7.43",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "postcss-prefix-selector": "^1.16.1",
    "rimraf": "^5.0.10",
    "sass": "^1.101.0",
    "shiki": "^3.23.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unocss": "^0.63.6",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "^1.6.4",
    "vitest": "catalog:",
    "vue": "^3.5.39",
    "vue-tsc": "^2.2.12"
  },
  "simple-git-hooks": {
    "pre-commit": "vp staged"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": ["docs"],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
      "vite-plus": "0.2.5"
    }
  },
  "overrides": {
    "vite": "catalog:",
    "vitepress>vite": "npm:vite@5.4.21",
    "@spark-ui/docs>vite": "npm:vite@5.4.21",
    "@spark-ui/docs>@unocss/vite>vite": "npm:vite@5.4.21",
    "framer-motion": "13.2.0",
    "motion-dom": "13.2.0",
    "motion-utils": "13.0.0"
  }
}
