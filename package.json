{
  "name": "@spark-ui/monorepo",
  "version": "0.0.2",
  "private": false,
  "description": "Experience The Magic Of Animated Components. Crafted With Vue, TypeScript, TailwindCss And Vueuse Motion",
  "keywords": [
    "animated-ui",
    "nuxt-ui",
    "nuxt-ui-components",
    "ui",
    "ui-components",
    "vue3-ui",
    "vue3-ui-components"
  ],
  "homepage": "https://ui.selemon.dev",
  "bugs": {
    "url": "https://github.com/selemondev/spark-ui/issues"
  },
  "license": "MIT",
  "author": "Selemondev",
  "repository": {
    "type": "git",
    "url": "https://github.com/selemondev/spark-ui.git"
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "build": "pnpm --filter @spark-ui/docs build",
    "typecheck": "vue-tsc -b docs/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "sync:magic-ui": "node scripts/clone-magic-ui.ts && node scripts/build-magic-ui-registry.ts && node scripts/build-spark-ui-registry.ts && node scripts/compare-registries.ts && node scripts/update-component-history.ts && node scripts/normalize-repository.ts",
    "sync:magic-ui:issues": "node scripts/create-agent-issues.ts",
    "validate:agent-pr": "node scripts/validate-component.ts",
    "normalize:repository": "node scripts/normalize-repository.ts",
    "normalize:repository:check": "node scripts/normalize-repository.ts --check",
    "clean": "rimraf packages/*/{dist,es,lib}",
    "build:docs": "rimraf packages/*/{dist,es,lib} && nr -r -F \"./docs\" build",
    "build:cli": "rimraf packages/*/{dist,es,lib} && nr -r -F \"./packages/cli\" build",
    "test": "vp test",
    "coverage": "vp test run --coverage",
    "playground:dev": "nr --filter @spark-ui/playground dev",
    "docs:dev": "nr --filter @spark-ui/docs dev",
    "ui:dev": "nr --filter @spark-ui/ui dev",
    "generate:release": "npx changelogen@latest --release",
    "postinstall": "simple-git-hooks",
    "package-minor:updates": "npx taze@latest minor -r",
    "package-major:updates": "npx taze@latest major -r"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@vue/compiler-core": "^3.5.35",
    "cross-env": "^7.0.3",
    "motion-v": "1.0.0-beta.2",
    "typescript": "^5.9.3",
    "vite-plugin-posthog": "^2.1.0",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/ni": "^0.23.2",
    "@shikijs/transformers": "^3.23.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/core": "^11.3.0",
    "autoprefixer": "^10.5.0",
    "eslint-plugin-format": "^0.1.3",
    "flexsearch": "^0.7.43",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "postcss-prefix-selector": "^1.16.1",
    "rimraf": "^5.0.10",
    "sass": "^1.100.0",
    "shiki": "^3.23.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unocss": "^0.63.6",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vite-plus": "catalog:",
    "vitepress": "^1.6.4",
    "vitest": "catalog:",
    "vue": "^3.5.35",
    "vue-tsc": "^2.2.12"
  },
  "simple-git-hooks": {
    "pre-commit": "vp staged"
  },
  "packageManager": "pnpm@9.15.9"
}
