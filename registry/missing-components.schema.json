{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-ui.dev/schemas/missing-components.schema.json",
  "title": "Missing MagicUI Components",
  "type": "object",
  "required": ["generatedAt", "count", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "count": { "type": "integer", "minimum": 0 },
    "components": { "type": "array" }
  }
}
